<global_preferences>
  <run_if_user_active>1</run_if_user_active>
  <run_gpu_if_user_active>0</run_gpu_if_user_active>
  <max_ncpus_pct>100</max_ncpus_pct>
  <cpu_usage_limit>100</cpu_usage_limit>
  <!-- Host activity detection is unreliable inside a container. -->
  <suspend_cpu_usage>0</suspend_cpu_usage>
  <leave_apps_in_memory>1</leave_apps_in_memory>
  <work_buf_min_days>0.05</work_buf_min_days>
  <work_buf_additional_days>0</work_buf_additional_days>
  <disk_max_used_gb>4</disk_max_used_gb>
  <disk_min_free_gb>0.5</disk_min_free_gb>
  <disk_max_used_pct>90</disk_max_used_pct>
  <ram_max_used_busy_pct>10</ram_max_used_busy_pct>
  <ram_max_used_idle_pct>10</ram_max_used_idle_pct>
</global_preferences>
